{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joycytao/what-happened-on-this-day-math/schemas/monthly-content-v2.schema.json",
  "title": "Month-only Worksheet Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "month", "days", "answerKey", "sources"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "month": {"type": "integer", "minimum": 1, "maximum": 12},
    "days": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/day"}},
    "answerKey": {"type": "object", "required": ["level1", "level2", "level3"], "properties": {"level1": {"type": "array"}, "level2": {"type": "array"}, "level3": {"type": "array"}}, "additionalProperties": false},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "day": {"type": "object", "additionalProperties": false, "required": ["month", "day", "eventYear", "emoji", "theme", "title", "hook", "readingPassage", "trivia", "mathLevels", "answers", "answerKeyEntries", "sourceIds"], "properties": {"month": {"type": "integer"}, "day": {"type": "integer", "minimum": 1, "maximum": 31}, "eventYear": {"type": ["integer", "null"]}, "eventYearNote": {"type": "string"}, "emoji": {"type": "string"}, "theme": {"enum": ["inventions_daily_life", "animals_dinosaurs", "incredible_challenges"]}, "title": {"type": "string"}, "hook": {"type": "string"}, "readingPassage": {"type": "string"}, "trivia": {"type": "array", "items": {"type": "string"}}, "mathLevels": {"type": "object"}, "answers": {"type": "object"}, "answerKeyEntries": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}:level[1-3]$"}}, "sourceIds": {"type": "array", "items": {"type": "string"}}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "title", "publisher", "url", "accessedDate"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "publisher": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}, "accessedDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}}
  }
}
