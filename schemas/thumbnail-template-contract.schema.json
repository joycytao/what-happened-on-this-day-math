{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6pm-studio.com/schemas/thumbnail-template-contract.schema.json",
  "title": "Versioned Monthly Thumbnail Template Contract",
  "type": "object",
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "templates": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": ["version", "canvas", "fixed_regions", "variable_regions", "assets", "layout"],
      "properties": {
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "canvas": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "const": 1260 },
            "height": { "const": 1260 }
          },
          "additionalProperties": false
        },
        "fixed_regions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/region" }
        },
        "variable_regions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/region" }
        },
        "assets": {
          "type": "object",
          "required": ["reference", "logo"],
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "logo": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "required": ["z_order", "crop_anchor", "shadow", "border_policy", "typography"],
          "properties": {
            "z_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "crop_anchor": { "enum": ["center", "left", "right"] },
            "shadow": { "type": "boolean" },
            "border_policy": { "enum": ["preserve", "none", "variable"] },
            "typography": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
