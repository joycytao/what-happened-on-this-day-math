{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joycytao/what-happened-on-this-day-math/schemas/monthly-content.schema.json",
  "title": "What Happened on This Day Monthly Worksheet Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "month",
    "days",
    "answerKey",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this intermediate content contract."
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "description": "Calendar month represented as YYYY-MM."
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dailyRecord"
      },
      "description": "One record per calendar day, in chronological order."
    },
    "answerKey": {
      "$ref": "#/$defs/monthAnswerKey"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "dailyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "emoji",
        "theme",
        "title",
        "hook",
        "readingPassage",
        "trivia",
        "mathLevels",
        "answers",
        "answerKeyEntries",
        "sourceIds"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "emoji": {
          "type": "string",
          "minLength": 1,
          "description": "Exactly one student-facing topic emoji."
        },
        "theme": {
          "type": "string",
          "enum": [
            "inventions_daily_life",
            "animals_dinosaurs",
            "incredible_challenges"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "readingPassage": {
          "type": "string",
          "minLength": 1,
          "description": "Student-facing English passage; validator enforces 150-250 words."
        },
        "trivia": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mathLevels": {
          "$ref": "#/$defs/mathLevels"
        },
        "answers": {
          "$ref": "#/$defs/answers"
        },
        "answerKeyEntries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}:level[1-3]$"
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mathLevels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level1",
        "level2",
        "level3"
      ],
      "properties": {
        "level1": {
          "$ref": "#/$defs/mathLevel"
        },
        "level2": {
          "$ref": "#/$defs/mathLevel"
        },
        "level3": {
          "$ref": "#/$defs/mathLevel"
        }
      }
    },
    "mathLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageType",
        "skill",
        "prompt",
        "numbersUsed"
      ],
      "properties": {
        "pageType": {
          "type": "string",
          "enum": [
            "level1",
            "level2",
            "level3"
          ]
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "numbersUsed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/numberUsed"
          }
        }
      }
    },
    "numberUsed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "source"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level1",
        "level2",
        "level3"
      ],
      "properties": {
        "level1": {
          "$ref": "#/$defs/answer"
        },
        "level2": {
          "$ref": "#/$defs/answer"
        },
        "level3": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation",
        "work",
        "finalAnswer"
      ],
      "properties": {
        "equation": {
          "type": "string",
          "minLength": 1
        },
        "work": {
          "type": "string",
          "minLength": 1
        },
        "finalAnswer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "monthAnswerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level1",
        "level2",
        "level3"
      ],
      "properties": {
        "level1": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answerKeyEntry"
          }
        },
        "level2": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answerKeyEntry"
          }
        },
        "level3": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answerKeyEntry"
          }
        }
      }
    },
    "answerKeyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "date",
        "level",
        "equation",
        "work",
        "finalAnswer"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}:level[1-3]$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "level": {
          "type": "string",
          "enum": [
            "level1",
            "level2",
            "level3"
          ]
        },
        "equation": {
          "type": "string",
          "minLength": 1
        },
        "work": {
          "type": "string",
          "minLength": 1
        },
        "finalAnswer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "accessedDate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accessedDate": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
