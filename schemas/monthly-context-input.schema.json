{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6pm-studio.com/schemas/monthly-context-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["month", "days"],
  "properties": {
    "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "title", "context", "questions"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{1,2}/[0-9]{1,2}$" },
          "title": { "type": "string", "minLength": 1 },
          "context": { "type": "string", "minLength": 1 },
          "questions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level1", "level2", "level3"],
            "properties": {
              "level1": { "$ref": "#/$defs/question" },
              "level2": { "$ref": "#/$defs/question" },
              "level3": { "$ref": "#/$defs/question" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "answer"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 }
      }
    }
  }
}
